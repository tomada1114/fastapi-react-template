{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": ["**", "!src/routeTree.gen.ts", "!openapi.json", "!src/api/generated"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 88
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
