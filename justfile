# Development task runner — requires Just (https://just.systems)
# All commands also work without Just by running the uv and pnpm commands directly.

# The FastAPI app in backend/: `just backend <recipe>`
mod backend

# The React app in frontend/: `just frontend <recipe>`
mod frontend

# Show available recipes
default:
    @just --list

# The hooks are the only guard that runs for every author, so a missing one
# fails the install. ALLOW_MISSING_GIT_HOOKS=1 is the deliberate opt-out and
# CI=true (CI commits nothing) skips the failure: both still attempt the
# install, and turn a failed install or a missing hook into a warning. A linked
# worktree never installs: it only verifies the hooks it shares with the primary
# checkout. A failed pnpm install (no pnpm, or no Node.js 24 to download) does
# not stop the hooks from being installed, but still fails the recipe, exempt or
# not.
# Install dependencies and the git hooks, then verify the hooks are in place
install:
    #!/usr/bin/env bash
    set -euo pipefail
    uv sync --all-groups --locked
    pnpm_status=0
    pnpm install --frozen-lockfile || pnpm_status=$?
    if [ "$pnpm_status" -ne 0 ]; then
      echo "error: pnpm install --frozen-lockfile failed (exit $pnpm_status). Install pnpm 11 ('corepack enable'), with nodejs.org reachable or Node.js 24 per .node-version, then rerun 'just install'." >&2
    fi
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
      echo "Skipping pre-commit hook installation (not a Git repository)."
      exit "$pnpm_status"
    fi
    # --git-path prints a path relative to the current directory unless it is
    # absolute (a linked worktree), so resolve it from the top level.
    cd "$(git rev-parse --show-toplevel)"
    is_exempt=0
    ci=$(printf '%s' "${CI:-}" | tr '[:upper:]' '[:lower:]')
    [ "$ci" = "true" ] && is_exempt=1
    [ "${ALLOW_MISSING_GIT_HOOKS:-}" = "1" ] && is_exempt=1
    # A linked worktree shares the primary checkout's .git/hooks/: installing
    # there would point every checkout's hooks at this worktree's .venv, so it
    # only verifies them.
    git_dir=$(cd "$(git rev-parse --git-dir)" && pwd -P)
    common_dir=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
    primary=""
    if [ "$git_dir" != "$common_dir" ]; then
      primary=$(dirname "$common_dir")
      echo "Linked worktree: not installing the shared git hooks; verifying them."
    else
      uv run --locked pre-commit install --install-hooks || [ "$is_exempt" -eq 1 ]
    fi
    # The hook types come from .pre-commit-config.yaml's flow-style
    # default_install_hook_types list; without the key pre-commit installs
    # only the pre-commit hook.
    hook_types=pre-commit
    if [ -f .pre-commit-config.yaml ] && grep -q '^default_install_hook_types:' .pre-commit-config.yaml; then
      hook_types=$(sed -n 's/^default_install_hook_types:[[:space:]]*\[\(.*\)\].*$/\1/p' .pre-commit-config.yaml | tr ',' ' ' | xargs)
      if [ -z "$hook_types" ]; then
        echo "error: .pre-commit-config.yaml's default_install_hook_types is not a one-line [a, b] list." >&2
        exit 1
      fi
    fi
    missing=""
    for hook in $hook_types; do
      path=$(git rev-parse --git-path "hooks/$hook")
      case "$path" in /*) ;; *) path="$PWD/$path" ;; esac
      if [ ! -x "$path" ] || ! grep -q "File generated by pre-commit" "$path"; then
        missing="$missing $path"
      fi
    done
    if [ -z "$missing" ]; then
      echo "Git hooks verified: $hook_types."
    elif [ "$is_exempt" -eq 1 ]; then
      echo "Warning: git hooks missing (allowed by CI=true or ALLOW_MISSING_GIT_HOOKS=1):$missing" >&2
      [ -z "$primary" ] || echo "Install them by running 'just install' in the primary checkout: $primary" >&2
    else
      echo "error: git hooks missing:$missing" >&2
      if [ -n "$primary" ]; then
        echo "Run 'just install' in the primary checkout ($primary), not in this linked worktree, or set ALLOW_MISSING_GIT_HOOKS=1 to install without them." >&2
      else
        echo "Run 'uv run --locked pre-commit install --install-hooks', or set ALLOW_MISSING_GIT_HOOKS=1 to install without them." >&2
      fi
      exit 1
    fi
    exit "$pnpm_status"

# Alias for first-time project setup
setup: install

# frontend::fmt formats frontend/ with Biome; these lines format the Python tree.
# Format code (lint fixes first so the formatter has the last word)
fmt: frontend::fmt
    uv run --locked ruff check --fix .
    uv run --locked ruff format .

# backend::lint checks the app with backend/pyproject.toml's config; these lines
# check the whole tree with the root's (scripts/, tests/, and skill scripts for
# mypy). Both trees hold a `tests` package, so mypy runs once in each.
# frontend::lint runs Biome and tsc in frontend/.
# Run linters and type checker (the backend's and the frontend's first)
lint: backend::lint frontend::lint
    uv run --locked ruff check .
    uv run --locked ruff format --check .
    uv run --locked mypy

# backend::test runs the app's suite with the 80% branch-coverage floor over
# backend/src; frontend::test runs Vitest with its 80% floor over frontend/src;
# this line runs the root suite (the harness and the scripts' tests).
# Run tests in parallel with coverage (the backend's and the frontend's first)
test: backend::test frontend::test
    uv run --locked pytest -n auto

# The API (`just backend dev`, http://127.0.0.1:${MY_APP_API_PORT:-8000}) and
# the screen (`just frontend dev`, http://localhost:${VITE_PORT:-5173}, which
# proxies /api and /healthz to the API) run side by side. `set -m` gives each its
# own process group, so stopping one stops everything it started (uv, uvicorn's
# reloader and worker, pnpm, Vite); stdin is /dev/null because a background group
# that reads the terminal is stopped. Bash 3.2 (macOS) has no `wait -n`, so the
# loop polls with `kill -0`. When either exits, the other is stopped and its
# status is this recipe's; INT, TERM, and HUP stop both and exit 128 + the signal.
# Never ends on its own; an agent runs its own pair on free ports (running-the-app).
# Human-run: serve the screen on http://localhost:5173 and the API behind it; runs until stopped
dev:
    #!/usr/bin/env bash
    set -uo pipefail
    set -m
    {{ quote(just_executable()) }} backend dev </dev/null &
    api=$!
    {{ quote(just_executable()) }} frontend dev </dev/null &
    screen=$!
    set +m
    stop() {
      trap - INT TERM HUP EXIT
      kill -TERM -- "-$api" "-$screen" 2>/dev/null
      wait "$api" "$screen" 2>/dev/null
      tries=0
      while [ "$tries" -lt 100 ] && { kill -0 -- "-$api" 2>/dev/null || kill -0 -- "-$screen" 2>/dev/null; }; do
        sleep 0.1
        tries=$((tries + 1))
      done
      kill -KILL -- "-$api" "-$screen" 2>/dev/null
      return 0
    }
    trap 'stop; exit 130' INT
    trap 'stop; exit 143' TERM
    trap 'stop; exit 129' HUP
    trap stop EXIT
    while kill -0 "$api" 2>/dev/null && kill -0 "$screen" 2>/dev/null; do
      sleep 0.5
    done
    first=$api
    kill -0 "$api" 2>/dev/null && first=$screen
    wait "$first"
    rc=$?
    stop
    exit "$rc"

# Update uv.lock after changing dependency declarations
lock:
    uv lock

# Run all checks: format, lint, test
check: fmt lint test

# `lint` and `test` already run the frontend's lint and tests; frontend::build
# adds the production build, last.
# Non-mutating local PR gate (fail-fast: cheap gates before the suite)
verify: lock-check agents-check check-harness contract-check lint test-skills test frontend::build

# Export the backend's OpenAPI contract without a server or runtime settings
contract:
    uv run --locked --directory backend python -m my_app.api.contract --output ../frontend/openapi.json
    pnpm --dir frontend run api:generate

# Fail when the committed OpenAPI contract is missing or stale, without writing
contract-check:
    uv run --locked --directory backend python -m my_app.api.contract --output ../frontend/openapi.json --check
    uv run --locked python scripts/check_generated_client.py

# tests/harness checks skills, AGENTS.md (its Skills table and Quick Reference),
# recipes, the ruleset, labels, and workflows against each other.
# tests/test_product_section.py rides along because it is the harness's (g)
# check: in an app it stays red until AGENTS.md's Product section is filled in,
# which is not drift. `just test` runs both again as part of the whole suite.
# Fail on harness drift (tests/harness) or an unfilled Product section
check-harness:
    uv run --locked pytest tests/harness tests/test_product_section.py

# Each suite stays stdlib unittest; pytest-xdist runs suites across processes.
# The .claude/skills mirror is the same bytes, so only the authored tree runs.
# Run the test suites bundled with skills (.agents/skills/*/scripts/tests)
test-skills:
    PYTHONDONTWRITEBYTECODE=1 uv run --locked pytest -n auto -p no:cacheprovider .agents/skills/*/scripts/tests

# Confirm the lockfile is current without changing it.
lock-check:
    uv lock --check

# Regenerate the .claude/skills mirror from .agents/skills (the authored copy)
agents-sync:
    uv run --locked python scripts/sync_agents.py

# Fail when .claude/skills disagrees with .agents/skills
agents-check:
    uv run --locked python scripts/sync_agents.py --check

# Create or update the GitHub labels declared in .github/labels.yml (writes to GitHub)
labels *ARGS:
    uv run --locked python scripts/sync_labels.py {{ARGS}}

# Create or update the main branch ruleset from .github/rulesets/main.json (admin-only; writes to GitHub)
ruleset *ARGS:
    uv run --locked python scripts/apply_ruleset.py {{ARGS}}

# Remove build artifacts
clean:
    rm -rf dist/ build/ frontend/dist/ frontend/coverage/ .mypy_cache/ .ruff_cache/ .pytest_cache/ htmlcov/ .coverage .coverage.* coverage.xml
    rm -rf backend/.coverage backend/.coverage.* backend/htmlcov/ backend/.pytest_cache/ backend/.mypy_cache/ backend/.ruff_cache/
    find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
    find . -type d -name "*.egg-info" -exec rm -rf {} + 2>/dev/null || true

# The pnpm install runs only once pnpm-lock.yaml exists, so a checkout without
# the frontend's lockfile needs no pnpm.
# Install dependencies in a Codex-managed linked worktree without rewriting
# the shared pre-commit hook; install hooks once in the primary checkout.
worktree-prepare:
    uv sync --all-groups --locked
    if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; fi

# Create one issue worktree using the existing shipping-issues provisioner.
worktree-setup ISSUE BRANCH BASE ROOT VERIFY:
    bash .agents/skills/shipping-issues/scripts/worktree_setup.sh --issue {{ISSUE}} --branch {{BRANCH}} --base {{BASE}} --root {{ROOT}} --verify {{VERIFY}}

# Preview cleanup of one named branch. Only merged PR heads with clean worktrees qualify.
worktree-clean ROOT BRANCH:
    uv run --locked python scripts/worktree_cleanup.py --root {{ROOT}} --branch {{BRANCH}}

# Apply the previewed cleanup of one named branch; no --force or remote deletion.
worktree-clean-apply ROOT BRANCH:
    uv run --locked python scripts/worktree_cleanup.py --root {{ROOT}} --branch {{BRANCH}} --apply
