# The FastAPI app's recipes, a just module of the root justfile: run them as
# `just backend <recipe>` from anywhere in the repository. Each runs in this
# directory, so `uv run` reads backend/pyproject.toml's ruff, mypy, pytest, and
# coverage settings. CI's `Lint & Type Check` and `Coverage` jobs repeat the
# `lint` and `test` lines verbatim in a `working-directory: backend` step
# (tests/harness/test_just_recipes.py holds them equal).

# Lint and type-check the backend (ruff, ruff format --check, mypy strict)
lint:
    uv run --locked ruff check .
    uv run --locked ruff format --check .
    uv run --locked mypy

# Format the backend (lint fixes first so the formatter has the last word)
fmt:
    uv run --locked ruff check --fix .
    uv run --locked ruff format .

# Run the backend tests in parallel with branch coverage (80% floor)
test:
    uv run --locked pytest -n auto --cov --cov-report=term-missing:skip-covered --cov-fail-under=80

# The database db-upgrade, db-revision, and dev work on: MY_APP_DATABASE_URL,
# or the SQLite file backend/var/dev.db when it is unset or empty. Each recipe
# line sets it for its own command rather than exporting it, so `lint` and
# `test` run with the environment as it is.
database_url := if env("MY_APP_DATABASE_URL", "") == "" { "sqlite+aiosqlite:///./var/dev.db" } else { env("MY_APP_DATABASE_URL") }

# Migrate the database to the newest revision (default: backend/var/dev.db)
db-upgrade:
    mkdir -p var
    MY_APP_DATABASE_URL={{ quote(database_url) }} uv run --locked alembic upgrade head

# Autogenerate a revision from the change to adapters/sql/tables.py, against the migrated database
db-revision MESSAGE: db-upgrade
    MY_APP_DATABASE_URL={{ quote(database_url) }} uv run --locked alembic revision --autogenerate -m {{ quote(MESSAGE) }}

# Never ends on its own; an agent runs its own server on a free port instead (running-the-app).
# Human-run: migrate the database, then serve the API on http://127.0.0.1:8000, reloading on source changes
dev: db-upgrade
    MY_APP_DATABASE_URL={{ quote(database_url) }} uv run --locked uvicorn my_app.api.app:create_app --factory --reload
